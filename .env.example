# Keelway MCP Gateway — Environment Variable & Secret Reference Template
# Copy to .env for local development or inject via your container orchestrator / secret manager.
# Never commit real secrets or .env files.

# --- Runtime & Networking ---
# Socket address the gateway HTTP/SSE/MCP server binds to (default in container: 0.0.0.0:8080)
KEELWAY_BIND_ADDR=127.0.0.1:8080

# Path to the flight-recorder tape / replay file
KEELWAY_TAPE_PATH=./keelway.tape

# Tracing/logging filter (e.g., info, debug, keelway_engine=debug)
RUST_LOG=info

# --- Authentication & Signing Secrets (replace placeholders before deployment) ---
# Bearer/agent authentication token for gateway clients
KEELWAY_AGENT_TOKEN=<set-via-keelway-keygen>

# Ed25519 / cryptographic signing seed for verifiable receipts and attestations
KEELWAY_SIGNING_SEED=<set-via-keelway-keygen>

# HMAC-SHA256 shared secret for JWT verification (minimum 32 characters)
KEELWAY_JWT_HS256_SECRET=<32-plus-char-secret>
